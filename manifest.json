{
  "manifest_version": 3,
  "name": "VocabList",
  "version": "3.4",
  "description": "Vocabulary tracker with retro editorial UI, search tracking, and on-screen duplicate reminders.",
  "permissions": [
    "storage",
    "tabs",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "*://*.bing.com/*",
    "https://api.dictionaryapi.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "options_page": "dashboard.html"
}